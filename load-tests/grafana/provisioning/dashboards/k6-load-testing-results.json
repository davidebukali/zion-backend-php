      "title": "Real-Time Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none", "lineWidth": 1 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "title": "Active Virtual Users (VUs)",
      "type": "stat",
      "targets": [
        {
          "query": "SELECT last(\"value\") FROM \"vus\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }
      },
      "title": "Avg Response Time",
      "type": "stat",
      "targets": [
        {
          "query": "SELECT mean(\"value\") FROM \"http_req_duration\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "title": "95th Percentile Response Time",
      "type": "stat",
      "targets": [
        {
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }
      },
      "title": "Request Failure Rate",
      "type": "stat",
      "targets": [
        {
          "query": "SELECT mean(\"value\") FROM \"http_req_failed\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Throughput & Concurrency",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Requests Per Second (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE $timeFilter GROUP BY time(1s) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Active Virtual Users Ramp-Up",
      "type": "timeseries",
      "targets": [
        {
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time(1s) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Response Time Distribution (Latencies)",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 7,
      "title": "Response Latency Percentiles (p50, p90, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "query": "SELECT percentile(\"value\", 50) AS \"p50 (Median)\", percentile(\"value\", 90) AS \"p90\", percentile(\"value\", 95) AS \"p95\", percentile(\"value\", 99) AS \"p99\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time(1s) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    }
  ],
