APP_NAME=Tsiyon
APP_ENV=production # Use local if in development
APP_KEY=base64:2bPjM1Aju2kCIkoFizuXkbzb//IbLcDNz7dr5hbunzA=
APP_DEBUG=false # Use true if in development
APP_URL=https://tsiyonapp.com # Use localhost if in development

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (Docker PostgreSQL 17 Service)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=zionweb
DB_USERNAME=
DB_PASSWORD=

# Session, Cache, and Queue (Docker Redis Service)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=zion_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

HORIZON_PREFIX=zion-horizon:

# Mail Configuration (Resend)
MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@contact.tsiyonapp.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# Cloudflare R2 Object Storage
FILESYSTEM_DISK=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=zion-files
CLOUDFLARE_R2_ENDPOINT=https://95aa3575d918ea8b71070301c06c64bf.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://pub-e1cc51e7cf5f4a6e952c9a3b60d53203.r2.dev

VITE_APP_NAME="${APP_NAME}"
